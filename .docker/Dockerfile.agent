# Agent image: the base for `--env docker` llm trials.
#
# Ships the Claude Code CLI plus git and common shell tooling. Extended per
# repository through `llm.docker.setup`. Contains no credentials: they enter
# only as explicit env vars at container start.

# syntax=docker/dockerfile:1

# The image exists to ship the current Claude Code CLI, so neither it nor the
# apt packages are version-pinned.
# hadolint global ignore=DL3008,DL3016

FROM node:24.21.0-bookworm-slim@sha256:2fe369e969550cde8e867afc3fe370b260140cab4a23d467074295b42163d553

LABEL org.opencontainers.image.source="https://github.com/alexskrypnyk/skilltest"
LABEL org.opencontainers.image.description="skilltest agent base: Claude Code CLI plus common tooling for --env docker trials"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        jq \
        unzip \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code

WORKDIR /work
CMD ["bash"]
